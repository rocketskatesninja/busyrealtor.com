<IfModule mod_headers.c>
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), payment=(self \"https://js.stripe.com\")"

    Header always unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' js.stripe.com maps.googleapis.com *.googletagmanager.com *.google-analytics.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com fonts.gstatic.com; font-src 'self' fonts.gstatic.com data:; img-src 'self' data: https: blob:; frame-src 'self' js.stripe.com maps.google.com https://www.google.com; connect-src 'self' api.stripe.com fonts.googleapis.com fonts.gstatic.com maps.googleapis.com maps.google.com *.googletagmanager.com *.google-analytics.com *.analytics.google.com; worker-src blob:; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com; object-src 'none'; upgrade-insecure-requests;"
</IfModule>

# HTML is compressed, deliberately.
#
# A BREACH mitigation used to sit here: SetEnvIfNoCase Content-Type "text/html" no-gzip.
# It never did anything. SetEnvIfNoCase Content-Type tests the *request's* Content-Type,
# and a GET for a page has none, so the condition never matched and HTML was gzipped
# throughout. Measured on staging: 119,886 bytes uncompressed against 21,555 gzipped.
#
# Removed rather than fixed, which is a choice worth stating. BREACH needs an attacker who
# can watch response sizes on the wire *and* get their own input reflected into a response
# that carries the CSRF token. Turning HTML compression off to close that costs every
# visitor 5.6x the page weight on every request. That trade is not worth making here, and
# it is not what most of the web does. The worse option was the one we had: a rule that
# looked like protection, was cited as protection, and was inert.

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonicalize busyrealtor.com -> www.busyrealtor.com (matches APP_URL).
    # Without this, both hosts serve the app independently and the session
    # cookie (host-scoped, no Domain attr) doesn't follow users across.
    # Only fires on the production apex host; test.busyrealtor.com is unaffected.
    RewriteCond %{HTTP_HOST} ^busyrealtor\.com$ [NC]
    RewriteRule ^(.*)$ https://www.busyrealtor.com/$1 [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
