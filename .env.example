##
## BusyRealtor.com — Environment Configuration
## Copy to .env and fill in all required values.
## Never commit .env to version control.
##

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=BusyRealtor
APP_ENV=production
APP_KEY=                            # Generated by: php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com      # No trailing slash. Must match your domain.
APP_TIMEZONE=UTC

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error                     # debug|info|notice|warning|error|critical

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=busyrealtor             # Must match setup_db.sql
DB_USERNAME=busyrealtor_user        # Must match setup_db.sql
DB_PASSWORD=                        # Must match setup_db.sql

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null                 # Set to .yourdomain.com for subdomain sharing

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_STORE=file                    # file | redis | memcached

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=sync               # sync (no worker needed) | database | redis

# ── File Storage ─────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local               # local | s3

# AWS S3 (only required if FILESYSTEM_DISK=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp                    # smtp | sendmail | mailgun | ses | log
MAIL_HOST=smtp.mailgun.org          # e.g. smtp.mailgun.org, smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=                      # SMTP username / API key
MAIL_PASSWORD=                      # SMTP password / API secret
MAIL_ENCRYPTION=tls                 # tls | ssl | null
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Stripe (Cashier) ─────────────────────────────────────────────────────────
# These are set via Super Admin → Settings in the UI.
# You can also pre-populate them here for initial setup.
# Format: pk_live_... or pk_test_...
STRIPE_KEY=
# Format: sk_live_... or sk_test_...
STRIPE_SECRET=
# Format: whsec_...
STRIPE_WEBHOOK_SECRET=

# ── Google (Optional) ─────────────────────────────────────────────────────────
# Maps API key is set per-tenant in Tenant → Settings → Integrations
# Google OAuth (if using social login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── OPcache (recommended for production) ─────────────────────────────────────
# Configure in /etc/php/8.3/fpm/conf.d/10-opcache.ini:
# opcache.enable=1
# opcache.memory_consumption=256
# opcache.max_accelerated_files=20000
# opcache.validate_timestamps=0     # Set to 0 in production, 1 in dev
